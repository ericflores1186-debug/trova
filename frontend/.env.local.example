# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Find these in the Supabase Dashboard under:  Settings -> API Keys
#
# Everything here is NEXT_PUBLIC_*, meaning it ships to the browser.
# The PUBLISHABLE key is safe to expose -- schema.sql restricts it to SELECT
# via Row Level Security. The SECRET key must NEVER appear in this file.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (starts with sb_publishable_).
# Older projects show a legacy "anon" JWT starting with eyJ instead; that
# still works, and you can paste it here just the same.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Where the FastAPI backend from Phase 1 is running.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used to build absolute share/OG URLs on storefront pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
