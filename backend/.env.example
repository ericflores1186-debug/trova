# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
#
# Find these in the Supabase Dashboard under:  Settings -> API Keys
# (There is no "Settings -> API" page any more -- it's "API Keys".)
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# The SECRET key (starts with sb_secret_). Server-side only -- it bypasses
# Row Level Security, so it must never reach the browser.
# Older projects show a legacy "service_role" JWT starting with eyJ instead;
# that still works, and you can paste it here just the same.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model used for hotel/lodging entity extraction.
EXTRACTION_MODEL=claude-haiku-4-5

# --- Stay22 (hotel links) -------------------------------------------------
# Public affiliate ID that appears in every hotel link. Defaults to "trova".
# STAY22_AID=trova

# --- Travelpayouts (flight links) -----------------------------------------
TRAVELPAYOUTS_MOCK=true
TRAVELPAYOUTS_API_TOKEN=placeholder-travelpayouts-token
TRAVELPAYOUTS_MARKER=000000

# --- App ------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- YouTube transcript proxy (production only) ---------------------------
# YouTube blocks datacenter IPs, so transcript fetches fail on any cloud host
# while working fine locally. Leave these blank for local development.
# See DEPLOY.md section 3.5.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Or, for a non-Webshare proxy:
GENERIC_PROXY_HTTP_URL=
GENERIC_PROXY_HTTPS_URL=
